// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
 url      = env("DATABASE_URL") // หรือ leave blank หากใช้ prisma.config.ts
}


model User {
  id        Int      @id @default(autoincrement())
  name      String?
  company   String? 
  tel       String? 
  lineid    String? 
  email     String?  @unique
  password  String?
  package   String?  @default("Free")
  status    String?  @default("Active")
  numdate   Int?     @default(30)
  enddate   DateTime?
  createdAt DateTime @default(now())
  tunnelUrl              String?    // Cloudflare Tunnel URL ของสาขานี้
  apiToken               String?    // Secret Key สำหรับยืนยันตัวตน API
  pairingCode            String?    // รหัสจับคู่ 6 ตัว (หมดอายุ)
  pairingCodeExpiresAt   DateTime?  // เวลาหมดอายุรหัสจับคู่
  employees  SettingEmployee[]
  connectionsFrom BranchConnection[] @relation("ConnectionsFrom")
  connectionsTo   BranchConnection[] @relation("ConnectionsTo")
}

model SettingEmployee {
  id          Int     @id @default(autoincrement())
  company     String?   
  name        String?  
  position    String?
  level       String?
  username      String?  @unique
  password      String?
  passwords      String?
  mobile        Boolean  @default(false)
  timeIn        String?
  timeOut       String?
  salary        Float?    @default(0)
  otRate        Float?    @default(0)
  id_company      Int
  users        User  @relation(fields: [id_company], references: [id])
  checkinFace  CheckinFace?
  permissions  EmployeePermission[]
}

model CheckinFace {
  id             Int      @id @default(autoincrement())
  employeeId     Int      @unique
  faceDescriptor String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       SettingEmployee @relation(fields: [employeeId], references: [id])
}

model Getagory {
  id      Int     @id @default(autoincrement())
  list    String?
  company String?
}

model Group {
  id      Int     @id @default(autoincrement())
  list    String?
  company String?
}

model Fixname {
  id        Int     @id @default(autoincrement())
  shortlist String?
  list      String?
  company   String?
}

model Type {
  id        Int     @id @default(autoincrement())
  shortlist String?
  list      String?
  company   String?
}

model Unit {
  id      Int     @id @default(autoincrement())
  list    String?
  company String?
}

model Area {
  id      Int     @id @default(autoincrement())
  list    String?
  company String?
}

model Datalist {
  id             Int     @id @default(autoincrement())
  company        String?
  code           String?
  ProductName    String?
  fixname        String?
  group          String?
  type           String?
  subtype        String?
  Category       String?
  DrugRegistor   String?
  Area           String?
  Unit           String?
  Barcode        String?
  AlarmExp       String?
  Remark         String?
  Show           String?
  Child          String?
  CI             String?
  CostActual     Float?
  price          Float?
  wholesaleprice Float?
  online         Float?
  PriceA         Float?
  PriceB         Float?
  PriceC         Float?
  PriceD         Float?
  PriceE         Float?
  PriceF         Float?
  PriceG         Float?
  PriceH         Float?
  Max            Float?
  Min            Float?
  ROP            Float?
  pic            String?
  maker          String?   @default("")
  qty_unit       String?   @default("")
  concentration  Float?
  dosePerKg      Float?
  doseFrequency  Int?
  maxDosePerDay  Float?
  memberDiscountEligible Boolean @default(true)
  /// สินค้า lot — true (ค่าเริ่มต้น) = ต้องระบุ Lot/วันหมดอายุ ทุกธุรกรรม
  /// (รับสินค้า · ขายสินค้า · โอน · รับโอน · ปรับยอด)
  /// false = สินค้าไม่ติดตาม lot → ทุกธุรกรรมไม่ต้องกรอก/เลือก Lot
  ///
  /// หมายเหตุสำคัญ: ถึงแม้ requireLot = false ระบบยังคงบันทึกแถว RCitemlist ต่อการรับ
  /// หนึ่งครั้งเหมือนเดิม (เป็น "บัญชีสต็อก" กลางที่ทุกสูตรคงเหลือใช้ — ดู src/lib/stockBalance.ts)
  /// เพียงแต่ช่อง lot/dateExp จะว่าง และ UI จะไม่บังคับให้กรอก/เลือก
  requireLot     Boolean @default(true)
  drugSetItems   DrugSetItem[]

  @@index([company, Barcode])
  @@index([company, code])
}

/// บาร์โค้ดสำรอง (alias) ของสินค้า — หนึ่งสินค้า/หนึ่งหน่วยขาย มีได้หลายบาร์โค้ด
///
/// ตารางนี้เป็น "ดัชนีสำหรับค้นหา/สแกน" เท่านั้น ไม่ใช่ข้อมูลธุรกรรม:
///   * ทุกเส้นทางสแกนจะ resolve alias -> ตัวสินค้า แล้วใช้ Datalist.Barcode
///     (บาร์โค้ดหลัก) เขียนลงเอกสารเหมือนเดิมทุกประการ
///   * ห้ามเขียนค่าจากตารางนี้ลง RCitemlist.Barcode / Sale.barcode /
///     StockTransferItem.barcode / StockTransaction เด็ดขาด
/// ผลคือยอด คงเหลือ/รับ/ขาย/โอน/รับโอน/ปรับยอด ยังคำนวณจากคีย์เดิม 100%
/// (ดู src/lib/stockBalance.ts ที่ group ด้วย Datalist.Barcode)
model ProductBarcode {
  id          Int      @id @default(autoincrement())
  company     String?
  productCode String
  productId   Int?
  barcode     String
  note        String?  @default("")
  isActive    Boolean  @default(true)
  createdBy   String?  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([company, barcode])
  @@index([company, productCode])
  @@index([company, isActive])
}

model DrugSet {
  id          Int           @id @default(autoincrement())
  company     String?
  name        String
  description String?       @default("")
  status      String?       @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       DrugSetItem[]

  @@index([company, name])
  @@index([company, status])
}

model DrugSetItem {
  id        Int      @id @default(autoincrement())
  drugSetId Int
  productId Int?
  code      String?  @default("")
  name      String?  @default("")
  fixname   String?  @default("")
  drugGroup String?  @default("")
  barcode   String?  @default("")
  unit      String?  @default("")
  qty       Float    @default(1)
  salePrice Float?   @default(0)
  cost      Float?   @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  // หน่วยแปลง (UnitConversion) ที่เลือกให้รายการนี้ — null = ใช้หน่วยฐานของสินค้า
  unitConversionId Int?
  saleUnit         String? @default("")
  subQty           Float?  @default(1)
  // ราคาขายเฉพาะชุดนี้ — null = ใช้ราคาปกติตามระดับราคาที่ขายอยู่
  priceOverride    Float?
  drugSet   DrugSet  @relation(fields: [drugSetId], references: [id], onDelete: Cascade)
  product   Datalist? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([drugSetId])
  @@index([productId])
  @@index([code])
}

