model ConfirmRC {
  id          Int       @id @default(autoincrement())
  company     String?
  receiveId   Int       @unique
  status      String?   @default("confirmed")
  confirmedAt DateTime? @default(now())
  confirmedBy String?   @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  receive     Receive   @relation(fields: [receiveId], references: [id], onDelete: Cascade)

  @@index([company, status])
}

model RCitemlist {
  id           Int       @id @default(autoincrement())
  company      String?
  codenames    String?
  itemcode     String?
  itemName     String?
  unit         String?
  createDate   DateTime? @default(now())
  newCost      Float?
  /// ทุนสุทธิต่อหน่วยย่อย หลังหักส่วนลดต่อบรรทัด = (totalcost − discountbaht) ÷ qty
  /// สูตรและเหตุผลทั้งหมดอยู่ที่ src/lib/lotCost.ts — ห้ามคำนวณเองที่อื่น
  /// null = ยังไม่คำนวณ (ตัวอ่านคำนวณสดให้เอง) ไม่ได้แปลว่า "ไม่มีส่วนลด"
  /// ⚠️ ต้องเป็น Float? เปล่า ๆ ห้ามใส่ @default/NOT NULL — db push ตอนลูกค้าอัปเดต
  ///    จะมองเป็น drift แล้ว drop+recreate ทิ้งทุกครั้ง (เคยเกิดกับ MainLevel มาแล้ว)
  netCost      Float?
  qty          Float?
  totalcost    Float?
  lot          String?
  dateExp      DateTime?
  freebaht     Float?
  discountbaht Float?
  sale         Float?
  Barcode      String?
  type         String?   @default("")
  subtype      String?   @default("")
  person       String?
  statuss      String?
  dateRC       DateTime?
  balance     Float?
  codevender  String?   @default("")
  namevender  String?   @default("")
  maker       String?   @default("")
  qty_unit    String?   @default("")

  /// ══ หน่วยขาย (pack) ที่ใช้ "รับเข้า" จริง — ดู src/lib/receiveUnit.ts ══
  /// รับเป็นลัง/กล่อง/แพ็ค (UnitConversion) ได้ โดยที่ qty/unit ยังเป็น "หน่วยย่อย"
  /// (หน่วยฐานของสินค้า = Datalist.Unit) เสมอ:
  ///     qty  = saleQty × saleFactor        unit = Datalist.Unit
  /// สามฟิลด์นี้เป็นข้อมูล "ที่มาของจำนวน" ไว้แสดง/ตรวจสอบย้อนหลังเท่านั้น
  /// ทุกสูตรคงเหลือ/ต้นทุนยังอ่าน qty · unit · newCost (ต่อหน่วยย่อย) เหมือนเดิม
  /// จึงไม่กระทบยอดสต็อกเดิม และแถวเก่า (null) = รับด้วยหน่วยฐาน factor 1
  ///
  /// ⚠️ อย่าสับสนกับคอลัมน์ sale ด้านบน — sale คือ "ตัวนับจำนวนที่ขายไปแล้ว" ของ lot
  /// จำนวนที่รับในหน่วยขาย เช่น 2 (กล่อง)
  saleQty     Float?
  /// ชื่อหน่วยขายที่รับเข้า เช่น "กล่อง" (ว่าง/null = รับด้วยหน่วยฐาน)
  saleUnit    String?
  /// จำนวนหน่วยย่อยต่อ 1 หน่วยขาย (UnitConversion.subQty) — หน่วยฐาน = 1
  saleFactor  Float?

  @@index([company, dateRC])
  @@index([company, Barcode])
  @@index([company, itemcode])
}

model SaleMain {
  id            Int       @id @default(autoincrement())
  createDate    DateTime? @default(now())
  id_costomer   Int?
  code_costomer String?
  group_price   String?
  pay           String?
  bill          Int?
  discount      Float?
  memberDiscount Float? @default(0)
  memberDiscountPercent Float? @default(0)
  sumtotal      Float?
  addreward     Float?
  usereward     Float?
  companyall    String?
  personall     String?
  statussall    String?
  totalall      Float?
  orderNo       String?
  transferDetail String?
  cashAmount    Float?
  transferAmount Float?
  serviceCharge Float?   @default(0) // ค่าธรรมเนียมบัตร (เช่น EDC) เรียกเก็บเพิ่มจากลูกค้า — แยกจาก sumtotal (sumtotal = ยอดสินค้า)
  serviceChargePercent Float? @default(0)
  discountReason String?  @default("")
  taxInvoiceNo   String?  @default("")
  vatAmount      Float?   @default(0)
  beforeVat      Float?   @default(0)
  sales         Sale[]
  historys      History[]
 
  @@index([companyall, statussall, createDate])
}


model Sale {
  id           Int       @id @default(autoincrement())
  createDate   DateTime? @default(now())
  company      String?
  id_product   Int?
  code_product String?
  name_product String?
  cetagory     String?  @default("")
  fixname      String?
  unit         String?
  qty          Float?
  subunit      String? @default("")
  subqty       Float?  @default(0)
  cost         Float?  @default(0)
  price        Float?
  discount     Float?  @default(0)
  memberDiscount Float? @default(0)
  memberDiscountPercent Float? @default(0)
  total        Float?
  barcode      String? @default("")
  id_receive1  Float?
  lot_receive1 String?
  qty_lot1     Float?
  id_receive2  Float?
  lot_receive2 String?
  qty_lot2     Float?
  id_receive3  Float?
  lot_receive3 String?
  qty_lot3     Float?
  person       String?
  statuss      String?
  type         String?  @default("")
  name_customer String?  @default("")
  id_card      String?  @default("")
  phone        String?  @default("")
  pharmacy     String?  @default("")
  gifts        Float?  @default(0)
  id_salemain  Int
  salemain     SaleMain  @relation(fields: [id_salemain], references: [id])

  @@index([company, statuss, createDate])
  @@index([company, barcode])
}

