  otDate        DateTime?
  startTime     String?   @default("")
  endTime       String?   @default("")
  hours         Float?    @default(0)
  reason        String?   @default("")
  status        String?   @default("pending")
  rejectReason  String?   @default("")
  approvedBy    String?   @default("")
  approvedDate  DateTime?
  createdAt     DateTime  @default(now())
}

// =============================================
// Omnichannel Chat & Telepharmacy Models
// =============================================

model ChatChannel {
  id            Int       @id @default(autoincrement())
  company       String?   @default("")
  platform      String    // LINE, FACEBOOK, TIKTOK, WEB
  channelName   String?   @default("")
  accessToken   String?   @default("")
  channelSecret String?   @default("")
  pageId        String?   @default("")
  webhookUrl    String?   @default("")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  contacts      ChatContact[]
  @@index([company])
}

model ChatContact {
  id              Int       @id @default(autoincrement())
  company         String?   @default("")
  channelId       Int
  channel         ChatChannel @relation(fields: [channelId], references: [id])
  platformUserId  String    // LINE userId, FB PSID, TikTok userId
  displayName     String?   @default("")
  avatarUrl       String?   @default("")
  phone           String?   @default("")
  email           String?   @default("")
  tags            String?   @default("")
  consentGiven    Boolean   @default(false)
  consentDate     DateTime?
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  conversations   ChatConversation[]
  @@unique([channelId, platformUserId])
  @@index([company])
}

model ChatConversation {
  id            Int       @id @default(autoincrement())
  company       String?   @default("")
  contactId     Int
  contact       ChatContact @relation(fields: [contactId], references: [id])
  assignedTo    String?   @default("")   // agent/employee name
  status        String    @default("open") // open, pending, resolved, closed
  subject       String?   @default("")
  priority      String?   @default("normal") // low, normal, high, urgent
  lastMessageAt DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      ChatMessage[]
  videoCalls    VideoCall[]
  @@index([company])
  @@index([status])
}

model ChatMessage {
  id              Int       @id @default(autoincrement())
  conversationId  Int
  conversation    ChatConversation @relation(fields: [conversationId], references: [id])
  senderType      String    // customer, agent, system
  senderName      String?   @default("")
  messageType     String    @default("text") // text, image, file, video, audio, sticker, location, richcard
  content         String?   @default("")
  mediaUrl        String?   @default("")
  metadata        String?   @default("{}") // JSON: platformMsgId, quickReplies, etc.
  isRead          Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  @@index([conversationId])
  @@index([createdAt])
}

model VideoCall {
  id              Int       @id @default(autoincrement())
  company         String?   @default("")
  conversationId  Int
  conversation    ChatConversation @relation(fields: [conversationId], references: [id])
  roomId          String    @unique
  initiatedBy     String?   @default("") // agent name
  status          String    @default("pending") // pending, ringing, active, ended, missed
  startedAt       DateTime?
  endedAt         DateTime?
  duration        Int?      @default(0) // seconds
  recordingUrl    String?   @default("")
  notes           String?   @default("")
  consentGiven    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  @@index([company])
  @@index([roomId])
}

model ChatQuickReply {
  id        Int      @id @default(autoincrement())
  company   String?  @default("")
  title     String?  @default("")
  content   String?  @default("")
  category  String?  @default("")
  shortcut  String?  @default("")
  createdAt DateTime @default(now())
  @@index([company])
}


// ============================================================
// Telegram Notification
// ============================================================
model TelegramBinding {
  id            Int       @id @default(autoincrement())
  company       String
  branchId      Int?
  chatId        String    @default("")
  chatTitle     String?   @default("")
  chatType      String?   @default("")
  notifySale    Boolean   @default(true)
  notifyCancel  Boolean   @default(true)
  notifyHourly  Boolean   @default(true)
  notifyDaily   Boolean   @default(true)
  minAmount     Float     @default(0)
  quietStart    String?   @default("")
  quietEnd      String?   @default("")
  bindToken     String    @unique
  bindExpiresAt DateTime?
  isActive      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([company, branchId])
  @@index([chatId])
}

model TelegramNotifyLog {
  id         Int      @id @default(autoincrement())
  bindingId  Int
  eventType  String
  refType    String?  @default("")
  refId      Int?
  payload    String?  @default("")
  success    Boolean  @default(false)
  error      String?  @default("")
  sentAt     DateTime @default(now())
  @@index([bindingId, sentAt])
}


model DailyClose {
  id              Int       @id @default(autoincrement())
  company         String
  closeDate       DateTime  @db.Date
  workTimeStart   String?
  workTimeEnd     String?
  salesTotal      Float     @default(0)
  promptpayTotal  Float     @default(0)
  transferTotal   Float     @default(0)
  cashTotal       Float     @default(0)
  otherTotal      Float     @default(0)
  cashDeliver     Float     @default(0)
  note            String?
  b1000           Int       @default(0)
  b500            Int       @default(0)
  b100            Int       @default(0)
  b50             Int       @default(0)
  b20             Int       @default(0)
  b10             Int       @default(0)
  b5              Int       @default(0)
  b2              Int       @default(0)
  b1              Int       @default(0)
  totalCounted    Float     @default(0)
  diff            Float     @default(0)
  changeAmount    Float     @default(0)
  drawerBalance   Float     @default(0)
  employeeName    String    @default("")
  branchName      String?
  status          String    @default("draft")
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([company, closeDate, employeeName])
  @@index([company, closeDate])
  @@index([status])
}

// ===========================================
// ตารางสำรองค่าเดิมของ SelfHeal (audit/rollback)
// สร้างจริงตอนรันด้วย CREATE TABLE IF NOT EXISTS ใน
// src/lib/selfHeal.ts และ src/lib/lotRelink.ts
// ประกาศไว้ที่นี่เพื่อไม่ให้ prisma db push สั่ง DROP ทิ้ง
//
// ⚠️ log_id ในฐานข้อมูลเป็น SERIAL (มี default nextval) จริง แต่ที่นี่
// จงใจไม่ใส่ @default(autoincrement()) — Prisma มองข้ามการตรวจ autoincrement
// ของตารางที่ชื่อขึ้นต้นด้วย "_" (สงวนไว้ให้ implicit relation table) ถ้าใส่ไว้
// db push จะพยายาม CREATE SEQUENCE ซ้ำแล้วล้มทุกครั้ง
// แอปเขียนตารางกลุ่มนี้ด้วย raw SQL ล้วน ไม่ได้ insert ผ่าน Prisma Client
// จึงไม่กระทบการใช้งาน
// ===========================================

model SelfhealRcitemlistSaleLog {
  log_id   Int      @id @default(dbgenerated("nextval('_selfheal_rcitemlist_sale_log_log_id_seq'::regclass)"))
  fixed_at DateTime @default(now()) @db.Timestamptz(6)
  rc_id    Int
  company  String?
  itemcode String?
  lot      String?
  qty      Float?
  freebaht Float?
  old_sale Float?
  new_sale Float?
  balance  Float?

  @@map("_selfheal_rcitemlist_sale_log")
}

model SelfhealRcitemlistDatercLog {
  log_id     Int       @id @default(dbgenerated("nextval('_selfheal_rcitemlist_daterc_log_log_id_seq'::regclass)"))
  fixed_at   DateTime  @default(now()) @db.Timestamptz(6)
  rc_id      Int
  company    String?
  codenames  String?
  itemcode   String?
  lot        String?
  old_daterc DateTime? @db.Timestamp(6)
  new_daterc DateTime? @db.Timestamp(6)

  @@map("_selfheal_rcitemlist_daterc_log")
}

model SelfhealLotRelinkLog {
  log_id   Int      @id @default(dbgenerated("nextval('_selfheal_lot_relink_log_log_id_seq'::regclass)"))
  fixed_at DateTime @default(now()) @db.Timestamptz(6)
  company  String?
  itemcode String?
  person   String?
  kind     String
  ref_id   Int
  before   Json?
  after    Json?

  @@map("_selfheal_lot_relink_log")
}

/// คิวรับสินค้าของหน้าขาย — 1 บิล = 1 คิว
/// เลขคิวรันใหม่ทุกวันโดยแยกตามบริษัท (ดู @@unique([company, queueDate, queueNo]))
model SaleQueue {
  id          Int       @id @default(autoincrement())
  company     String
  branch      String?   @default("")
  /// เลขคิวของวัน เริ่มที่ 1 ใหม่ทุกวัน
  queueNo     Int
  /// วันของคิวรูปแบบ YYYY-MM-DD (ตามเวลาเครื่องขาย) — ใช้เป็นขอบเขตของเลขรัน
  queueDate   String
  /// เลขที่ออเดอร์บนใบเสร็จ (DDMM-HHmmss) — ใช้กันสร้างคิวซ้ำเมื่อกดชำระซ้ำ
  orderNo     String?
  id_salemain Int?
  customer    String?   @default("")
  seller      String?   @default("")
  itemCount   Int       @default(0)
  totalAmount Float     @default(0)
  /// สรุปรายการสินค้าสำหรับใบ job และแผงสถานะคิว [{ name, qty, unit }]
  items       Json?
  /// waiting = รอทำ | preparing = กำลังทำ | ready = พร้อมรับ | done = รับแล้ว | cancelled = ยกเลิก
  status      String    @default("waiting")
  note        String?   @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  readyAt     DateTime?
  doneAt      DateTime?

  @@unique([company, queueDate, queueNo])
  @@unique([company, orderNo])
  @@index([company, queueDate, status])
}
