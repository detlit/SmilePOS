                        </Nav.Item>
                        <Nav.Item style={{ marginBottom: 4 }}>
                          <Nav.Link eventKey="seven" style={{ fontFamily: "kanit", fontSize: 13, padding: "10px 12px", borderRadius: 10, display: "flex", alignItems: "center", gap: 10, color: "#4b5563" }}>
                            <div style={{ width: 34, height: 34, borderRadius: 8, background: "#f3f4f6", display: "flex", alignItems: "center", justifyContent: "center" }}><Package size={16} color="#6b7280" /></div>
                            เนเธเธฃเธฑเธเธชเธดเธเธเนเธฒ
