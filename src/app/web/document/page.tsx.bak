                    <button
                      onClick={() => { maxV3(), setids(a.id), setidcus(a.id_costomer), localStorage.setItem("iddoc", a.id), setShowee(true) }}
                      className={a.re_status === null ? "btn btn-outline-primary" : "btn btn-outline-warning"} style={{ fontSize: 11, height: 26, marginLeft: 5, width: 50 }}>
                      {a.re_status === null ? "เธชเธฃเนเธฒเธ" : "เนเธเนเนเธ"}
