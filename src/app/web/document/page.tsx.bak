                  style={{ width: 80, height: 35, fontSize: 17, fontFamily: "Kanit" }}
                  onClick={() => {
                    setShow2(false),
                      setQT({ ...allQT, discount: discountS }),
                      setdiscountS(localStorage.getItem("discount_s") || "")
                    EditQuatation()
                  }}
                >
                  OK
                </button>
