                                          display: "flex", alignItems: "center", gap: 3,
                                          boxShadow: "0 2px 4px rgba(239,68,68,0.3)",
                                        }}>
                                          <AlertCircle size={10} /> {overdueCount}
                                        </span>
                                      )}
                                    </div>
                                    {/* Status flow mini-badges */}
                                    {doc.prefix && counts.total > 0 && (
