                        <div style={{ fontFamily: "kanit", fontSize: 13, color: "#1f2937", textAlign: "right" }}>{((Number(qt_detail.map(num => num).reduce((acc: any, curr: any) => acc + curr.total, 0)) * Number(allQT.taxnumber !== taxNum ? taxNum : allQT.taxnumber)) / 100).toFixed(1)}</div>
