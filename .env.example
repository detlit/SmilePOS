# Database Configuration
DATABASE_URL="postgresql://myuser:mypassword@postgres:5432/mydb?schema=public"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Cloudflare Tunnel Token (get from Cloudflare Dashboard)
# Go to: https://one.dash.cloudflare.com/ > Access > Tunnels > Create Tunnel
CLOUDFLARE_TUNNEL_TOKEN="<วาง tunnel token ของคุณที่นี่ — ห้าม commit ค่าจริง>"

# Bridge token สำหรับเชื่อมสาขา (สร้างเองเป็นสตริงสุ่มยาว ๆ)
BRIDGE_TOKEN="<random-secret>"
